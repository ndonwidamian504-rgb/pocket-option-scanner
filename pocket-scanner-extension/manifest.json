{
  "manifest_version": 3,
  "name": "Pocket Option Basilisk-Style Scanner",
  "version": "2.0.0",
  "description": "Analysis-only Pocket Option market scanner.",
  "permissions": [
    "storage",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://pocketoption.com/*",
    "https://*.pocketoption.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*"
      ],
      "js": [
        "scanner.js",
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Pocket Option Scanner"
  }
}
